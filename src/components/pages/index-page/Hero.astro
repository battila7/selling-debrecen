---
import heroBackgroundVideo from "../../../images/hero-background-video.mp4";
import heroBackgroundVideoPoster from "../../../images/hero-background-video-poster.jpg";
import DesktopHeader from "./DesktopHeader.astro";
import branding from "../../../content/general/branding.json";
import { useI18n } from "../../../i18n";
import navyLogo from "../../../images/sdg-logo-navy.png";
import { Image } from "astro:assets";

const { lang } = useI18n(Astro);
const localizedData = branding[lang as keyof typeof branding];
---

<section
  id="hero-section"
  class="relative flex flex-col min-h-screen overflow-hidden"
>
  <!-- Background Video -->
  <video
    autoplay
    muted
    loop
    playsinline
    poster={heroBackgroundVideoPoster.src}
    class="absolute inset-0 w-full h-full object-cover z-0"
    aria-hidden="true"
  >
    <source src={heroBackgroundVideo} type="video/mp4" />
  </video>

  <div class="relative flex-1 flex items-center w-full">
    <div class="absolute inset-0 bg-cream/80 z-0"></div>
    <div class="relative z-10 w-full">
      <div class="w-full flex flex-col items-center gap-6">
        <Image
          src={navyLogo}
          alt="Selling Debrecen Group Logo"
          class="h-32 md:h-40 w-auto"
        />
        <p class="font-old-style font-lighter text-xl md:text-3xl text-navy/90">
          {localizedData.slogan}
        </p>
      </div>
    </div>
  </div>

  <DesktopHeader />
</section>
